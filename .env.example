# VILAGENT startup settings. Copy to .env. Nothing about a model belongs here.
#
# Every model — the planner, the supervisor, FARA and memory search — is a connection you add in
# the app (Settings -> Models -> Connections): a nickname, the LangChain interface, an address, a
# model name and an API key. Keys are encrypted for your Windows user in <data dir>\connections.db
# and are never written to a file you can read. Budgets, approval rules, the browser and the log
# level live in <data dir>\.vilagent_state.json, also set from the app.
#
# Only the lines below are read, and only while the app starts.

# The Python interpreter with the agent's dependencies, used by `pnpm dev` and
# `pnpm build:server` in desktop/ (defaults to `python` on PATH).
# VILAGENT_PYTHON=C:\path\to\env\python.exe

# Where the gateway listens, and where its data lives (the launcher sets these itself).
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8001
# GATEWAY_ENABLE_DOCS=false
# VILAGENT_DATA_DIR=
